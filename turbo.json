{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  },
  "globalEnv": ["DATABASE_URL", "I18NEXUS_API_KEY", "VERCEL_OIDC_TOKEN"]
}
